# Set these in Vercel → Project → Settings → Environment Variables.
# For local `npm run dev`, put them in web/.env.local (Redis/Blob optional locally).

# Shared secret between the website and the worker on your PC (any long random string).
WORKER_SECRET=

# Added automatically when you connect an Upstash Redis store (Vercel Marketplace):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Added automatically when you connect a Vercel Blob store (choose "Public"):
# BLOB_READ_WRITE_TOKEN=

# Optional: require a passcode to create songs (share it with friends/team only).
ACCESS_CODE=
# Optional limits
RATE_LIMIT_PER_HOUR=6
MAX_QUEUE=20
