# Copy to worker/.env and fill in.

# Your Vercel site, e.g. https://aimusic-xxx.vercel.app (no trailing slash)
SITE_URL=http://localhost:3000
# Must match WORKER_SECRET in Vercel → Settings → Environment Variables
WORKER_SECRET=

# Claude login for this always-on service. Run `claude setup-token` once,
# then paste the long-lived token here. (Leave empty to use the CLI's normal login.)
CLAUDE_CODE_OAUTH_TOKEN=
# Optional: model alias for songwriting (sonnet / opus). Empty = Claude Code default.
CLAUDE_MODEL=

# auto = ACE-Step when it is running (vocals), otherwise the built-in synth (instrumental)
ENGINE=auto
ACESTEP_URL=http://127.0.0.1:8001
# Versions per request (more = slower; 2 is fine on an 8 GB GPU)
ACESTEP_BATCH=2
# Diffusion steps for the turbo model (8 recommended, max 20)
ACESTEP_STEPS=8

# How often to check the website for new requests while idle (ms)
POLL_INTERVAL_MS=10000
